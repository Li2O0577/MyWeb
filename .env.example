# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=0

# React build served by Flask in production-like mode
FRONTEND_DIST=frontend/dist

# Development CORS origins. Production same-origin mode usually does not need changes.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Background training task limits
MYWEB1_GLOBAL_TASK_CONCURRENCY=2
MYWEB1_USER_TASK_CONCURRENCY=1
MYWEB1_MAX_PENDING_TASKS_PER_USER=5

# Per-account data limits
MYWEB1_MAX_UPLOAD_MB=256
MYWEB1_MAX_DATASET_ROWS=500000
MYWEB1_MAX_DATASET_COLUMNS=1000
MYWEB1_MAX_SESSIONS_PER_USER=10

# Login failure rate limiting (per IP + username)
MYWEB1_LOGIN_MAX_FAILURES=5
MYWEB1_LOGIN_WINDOW_SECONDS=300
MYWEB1_LOGIN_LOCK_SECONDS=900
MYWEB1_REGISTER_MAX_ATTEMPTS=5
MYWEB1_REGISTER_WINDOW_SECONDS=3600

# LLM configuration
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=

# Keep this disabled unless you are intentionally using a local/private LLM endpoint.
LLM_ALLOW_LOCAL_API_BASE=0
